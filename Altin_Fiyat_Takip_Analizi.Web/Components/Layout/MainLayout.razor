@inherits LayoutComponentBase
@using Altin_Fiyat_Takip_Analizi.Web.Services
@inject ApiService Api
@implements IDisposable

@if (!Api.IsAuthenticated)
{
    <!-- Unauthenticated Full-Screen Layout: Immersive login portal without dashboard topbar -->
    <main class="w-100 min-vh-100 p-0 m-0" style="background: #070a12; overflow-x: hidden;">
        @Body
    </main>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>
        <main>
            <!-- Native Glassmorphic App Header -->
            <header class="topbar-native">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span style="display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:6px; background:rgba(226,176,62,0.15); color:var(--gold-500); font-size:0.9rem;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </span>
                        <span class="fw-bold" style="font-family:'Outfit',sans-serif; font-size:0.95rem; color:var(--slate-800); letter-spacing:-0.01em;">
                            Ahlatcı Altın Takip & Analiz
                        </span>
                    </div>
                    <span class="d-none d-md-inline" style="color:var(--slate-300); font-weight:300;">|</span>
                    <span class="d-none d-md-inline text-muted" style="font-size:0.82rem; font-weight:500;">
                        Pazaryeri & Banka Arbitraj Paneli
                    </span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="pulse-indicator-container pulse-live-green d-none d-sm-inline-flex">
                        <span class="pulse-dot pulse-dot-green"></span>
                        <span>Canlı Takip Aktif</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 ps-2" style="border-left:1px solid var(--border);">
                        <span class="badge rounded-pill px-2.5 py-1 text-uppercase" style="background:rgba(226,176,62,0.12); color:var(--gold-600); font-weight:700; font-size:0.75rem; letter-spacing:0.04em;">
                            @Api.CurrentRole
                        </span>
                        <span class="fw-semibold d-none d-md-inline" style="font-size:0.85rem; color:var(--slate-700);">
                            @Api.CurrentUsername
                        </span>
                    </div>
                </div>
            </header>

            <article class="content">
                @Body
            </article>

            <footer class="text-center py-3" style="color: var(--slate-500); font-size: 0.82rem; border-top: 1px solid var(--border);">
                © @DateTime.Now.Year Ahlatcı Kuyumculuk &bull; Altın Fiyat Takip & Analizi Sistemi
            </footer>
        </main>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Api.AuthStateChanged += OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Api.AuthStateChanged -= OnAuthChanged;
    }
}