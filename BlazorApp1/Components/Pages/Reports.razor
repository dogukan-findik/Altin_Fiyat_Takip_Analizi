@page "/raporlar"
@using Altin_Fiyat_Takip_Analizi.Web.Models
@using Altin_Fiyat_Takip_Analizi.Web.Services
@inject ApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Gunluk Raporlar</PageTitle>

<div class="page-header" id="report-header">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="bi bi-file-earmark-bar-graph me-2 text-gold"></i>Gunluk Raporlar</h2>
            <p>Altin fiyat karsilastirma raporlarini olusturun ve gecmis raporlari goruntuleyin.</p>
        </div>
        <div class="d-flex gap-2">
            @if (_report is not null)
            {
                <button class="btn btn-lg btn-outline-secondary"
                        style="border-radius:10px; padding:.75rem 1.5rem;"
                        @onclick="DownloadPdf">
                    <i class="bi bi-file-earmark-pdf me-2"></i>PDF'e Indir
                </button>
            }
            <button class="btn btn-lg" disabled="@_generating"
                    style="background:linear-gradient(135deg,#e2b03e,#c9982e); color:#1a1a2e; font-weight:700; border:none; border-radius:10px; padding:.75rem 1.5rem;"
                    @onclick="GenerateReport">
                @if (_generating)
                {
                    <span class="spinner-border spinner-border-sm me-2" style="width:1rem;height:1rem;" role="status"></span>
                    <span>Olusturuluyor...</span>
                }
                else
                {
                    <i class="bi bi-plus-circle me-2"></i>
                    <span>Rapor Olustur</span>
                }
            </button>
        </div>
    </div>
</div>

@if (!Api.IsAuthenticated)
{
    <div class="alert" style="background:#fef3c7; color:#92400e;">
        <i class="bi bi-lock me-2"></i>Bu sayfayi goruntulemek icin <a href="/login">giris yapmalisiniz</a>.
    </div>
}
else if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;"></div>
        <p class="text-muted mt-3">Rapor yukleniyor...</p>
    </div>
}
else if (_report is not null)
{
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert" style="background:#d1fae5; color:#065f46; margin-bottom:1.5rem;">
            <i class="bi bi-check-circle me-2"></i>@_successMessage
        </div>
    }

    <div id="report-container">
        <h3 class="mb-4 text-center">Gunluk Altin Fiyat Performans Raporu</h3>
        <div class="row g-4 mb-4">
            <div class="col-md-4 col-lg-2">
            <div class="stat-card stat-blue">
                <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
                <div class="stat-value">@_report.TotalProductsTracked</div>
                <div class="stat-label">Takip Edilen Urun</div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="stat-card stat-purple">
                <div class="stat-icon"><i class="bi bi-people"></i></div>
                <div class="stat-value">@_report.TotalSellersActive</div>
                <div class="stat-label">Aktif Satici</div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="stat-card stat-green">
                <div class="stat-icon"><i class="bi bi-arrow-down-circle"></i></div>
                <div class="stat-value">@_report.ProductsBelowAvg</div>
                <div class="stat-label">Ort. Altinda</div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="stat-card stat-red">
                <div class="stat-icon"><i class="bi bi-arrow-up-circle"></i></div>
                <div class="stat-value">@_report.ProductsAboveAvg</div>
                <div class="stat-label">Ort. Ustunde</div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="stat-card stat-amber">
                <div class="stat-icon"><i class="bi bi-percent"></i></div>
                <div class="stat-value">%@_report.AvgPriceDiffPercent.ToString("N1")</div>
                <div class="stat-label">Ort. Fark</div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="stat-card stat-slate">
                <div class="stat-icon"><i class="bi bi-collection"></i></div>
                <div class="stat-value">@_report.TotalPriceCollections</div>
                <div class="stat-label">Toplama Sayisi</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0" style="border-radius:16px;">
                <div class="card-body p-4" style="background:linear-gradient(135deg, #059669, #10b981); color:#fff; border-radius:16px;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="opacity-75 mb-1">En Ucuz Urununuz</h6>
                            <h4 class="fw-bold mb-1">@(_report.CheapestProductName ?? "Veri yok")</h4>
                            <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,.2);">
                                %@_report.CheapestProductDiffPercent.ToString("N1") rakiplerden ucuz
                            </span>
                        </div>
                        <i class="bi bi-trophy" style="font-size:2.5rem; opacity:.2;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0" style="border-radius:16px;">
                <div class="card-body p-4" style="background:linear-gradient(135deg, #dc2626, #ef4444); color:#fff; border-radius:16px;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="opacity-75 mb-1">En Pahali Urununuz</h6>
                            <h4 class="fw-bold mb-1">@(_report.MostExpensiveProductName ?? "Veri yok")</h4>
                            <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,.2);">
                                %@_report.MostExpensiveProductDiffPercent.ToString("N1") rakiplerden pahali
                            </span>
                        </div>
                        <i class="bi bi-exclamation-triangle" style="font-size:2.5rem; opacity:.2;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_report.Comparisons.Any())
    {
        <div class="card border-0 mb-4" style="border-radius:16px;">
            <div class="card-header d-flex justify-content-between align-items-center" style="border-radius:16px 16px 0 0; background:#fff; padding:1.25rem 1.5rem;">
                <h5 class="fw-bold mb-0"><i class="bi bi-table me-2 text-gold"></i>Urun Bazli Karsilastirma</h5>
                <span class="badge rounded-pill px-3 py-2" style="background:rgba(59,130,246,.1); color:#3b82f6;">@_report.Comparisons.Count urun</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Urun</th>
                                <th class="text-end">Bizim Fiyat</th>
                                <th class="text-end">Rakip Ort.</th>
                                <th class="text-end">Min Fiyat</th>
                                <th>Min Satici</th>
                                <th class="text-end">Max Fiyat</th>
                                <th>Max Satici</th>
                                <th class="text-end">Fark</th>
                                <th class="text-center">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _report.Comparisons)
                            {
                                var isCheaper = c.DiffFromAvg < 0;
                                var isExpensive = c.DiffFromAvg > 0;
                                <tr>
                                    <td class="fw-bold">@c.ProductName</td>
                                    <td class="text-end">@FormatPrice(c.OurPrice) TL</td>
                                    <td class="text-end">@FormatPrice(c.CompetitorAvgPrice) TL</td>
                                    <td class="text-end text-success">@FormatPrice(c.MinPrice) TL</td>
                                    <td><small class="text-muted">@c.MinPriceSeller</small></td>
                                    <td class="text-end text-danger">@FormatPrice(c.MaxPrice) TL</td>
                                    <td><small class="text-muted">@c.MaxPriceSeller</small></td>
                                    <td class="text-end fw-bold @(isCheaper ? "text-success" : isExpensive ? "text-danger" : "")">
                                        @(c.DiffFromAvg > 0 ? "+" : "")@FormatPrice(c.DiffFromAvg) TL
                                    </td>
                                    <td class="text-center">
                                        @if (isCheaper)
                                        {
                                            <span class="badge rounded-pill px-3 py-2" style="background:#d1fae5; color:#065f46;">Ucuzuz</span>
                                        }
                                        else if (isExpensive)
                                        {
                                            <span class="badge rounded-pill px-3 py-2" style="background:#fde2e2; color:#991b1b;">Pahaliyiz</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary px-3 py-2">Esit</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="text-center">
        <small class="text-muted">
            <i class="bi bi-clock me-1"></i>Rapor tarihi: @_report.ReportDate.ToString("dd.MM.yyyy") |
            Olusturulma: @_report.GeneratedAt.ToString("dd.MM.yyyy HH:mm:ss")
        </small>
    </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <div style="font-size:4rem; opacity:.3; margin-bottom:1rem;"><i class="bi bi-file-earmark-bar-graph"></i></div>
        <h4 class="text-muted mb-2">Henuz rapor olusturulmadi</h4>
        <p class="text-muted mb-4">Bugunun raporunu olusturmak icin asagidaki butona tiklayin.</p>
        <button class="btn btn-lg" disabled="@_generating"
                style="background:linear-gradient(135deg,#e2b03e,#c9982e); color:#1a1a2e; font-weight:700; border:none; border-radius:10px; padding:.75rem 2rem;"
                @onclick="GenerateReport">
            @if (_generating)
            {
                <span class="spinner-border spinner-border-sm me-2" style="width:1rem;height:1rem;" role="status"></span>
                <span>Olusturuluyor...</span>
            }
            else
            {
                <i class="bi bi-plus-circle me-2"></i>
                <span>Rapor Olustur</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert" style="background:#fde2e2; color:#991b1b; margin-top:1rem;">
            <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
        </div>
    }
}

@code {
    private DailyReportDto? _report;
    private bool _loading = true;
    private bool _generating;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadTodayReport();
    }

    private async Task LoadTodayReport()
    {
        _loading = true;
        _report = await Api.GetAsync<DailyReportDto>("api/v1/reports/daily/today");
        _loading = false;
    }

    private async Task GenerateReport()
    {
        _generating = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            var result = await Api.PostEmptyAsync<DailyReportDto>("api/v1/reports/daily/today/generate");
            if (result is not null)
            {
                _report = result;
                _successMessage = "Rapor basariyla olusturuldu!";
            }
            else
            {
                _errorMessage = "Rapor olusturulamadi. Lutfen tekrar deneyin.";
            }
        }
        catch
        {
            _errorMessage = "Bir hata olustu. Lutfen tekrar deneyin.";
        }

        _generating = false;
    }

    private async Task DownloadPdf()
    {
        await JS.InvokeVoidAsync("downloadPdf", "report-container", $"Gunluk-Rapor-{DateTime.Now:yyyyMMdd}.pdf");
    }

    private string FormatPrice(decimal price)
    {
        var culture = new System.Globalization.CultureInfo("tr-TR");
        return price.ToString("N2", culture);
    }
}
