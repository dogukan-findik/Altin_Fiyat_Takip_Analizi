@page "/banka-karsilastirma"
@using Altin_Fiyat_Takip_Analizi.Web.Models
@using Altin_Fiyat_Takip_Analizi.Web.Services
@implements IDisposable
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Banka Karşılaştırma</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <span style="font-size:2rem" class="me-3">🏦</span>
            <div>
                <h2 class="mb-0 fw-bold">Banka Altın Fiyatları</h2>
                <p class="text-muted mb-0">QNB Finans, Garanti ve Yapı Kredi bankalarının altın fiyatları, bizim fiyatlarımızla karşılaştırılıyor.</p>
            </div>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
            @if (_lastUpdated.HasValue)
            {
                <small class="text-muted">
                    <i class="bi bi-clock me-1"></i>Son Veri: @_lastUpdated.Value.ToString("HH:mm:ss")
                </small>
            }
            <div class="d-flex align-items-center gap-2 mt-1">
                @if (_isSyncing)
                {
                    <span class="badge bg-warning text-dark border border-warning px-2 py-1" style="font-size: 0.82rem;">
                        <span class="spinner-border spinner-border-sm me-1 text-dark" role="status"></span>
                        ⚡ Bankalar Canlı Taranıyor...
                    </span>
                }
                else if (_lastLoadedScrapedAt.HasValue)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="font-size: 0.82rem;">
                        <i class="bi bi-check2-circle me-1"></i>Son Tarama: @_lastLoadedScrapedAt.Value.ToLocalTime().ToString("HH:mm:ss")
                    </span>
                }

                <button class="btn btn-primary btn-sm shadow-sm d-flex align-items-center gap-2 px-3 py-1"
                        @onclick="TriggerLiveSyncAsync"
                        disabled="@(_isSyncing || _refreshing)"
                        title="Banka altın kurlarını canlı tara ve güncelle">
                    <i class="bi bi-arrow-clockwise @(_isSyncing || _refreshing ? "spin" : "")"></i>
                    <span>@(_isSyncing ? "Taranıyor..." : "Fiyatları Güncelle")</span>
                </button>
            </div>
        </div>
    </div>

    @if (!Api.IsAuthenticated)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <span class="me-2">🔒</span>
            <span>Bu sayfayı görüntülemek için <a href="/login" class="alert-link">giriş yapmalısınız</a>.</span>
        </div>
    }
    else if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="text-muted mt-3">Banka fiyatları yükleniyor...</p>
        </div>
    }
    else if (_breakdown is null || _breakdown.Count == 0)
    {
        <div class="alert alert-info d-flex align-items-center">
            <span class="me-2">ℹ️</span>
            <span>Henüz banka karşılaştırma verisi bulunmuyor.</span>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card stat-green shadow-sm">
                    <i class="bi bi-shield-check stat-icon"></i>
                    <div class="stat-label">Biz Daha Ucuzuz</div>
                    <div class="stat-value">@_cheaperCount <span style="font-size:1rem; font-weight:500; opacity:0.85;">ürün</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card stat-red shadow-sm">
                    <i class="bi bi-exclamation-triangle stat-icon"></i>
                    <div class="stat-label">Biz Daha Pahalıyız</div>
                    <div class="stat-value">@_expensiveCount <span style="font-size:1rem; font-weight:500; opacity:0.85;">ürün</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card stat-slate shadow-sm">
                    <i class="bi bi-dash-circle stat-icon"></i>
                    <div class="stat-label">Veri Yok / Eşit</div>
                    <div class="stat-value">@_equalCount <span style="font-size:1rem; font-weight:500; opacity:0.85;">ürün</span></div>
                </div>
            </div>
        </div>

        @foreach (var product in _breakdown)
        {
            var validPrices = product.SellerPrices.Where(sp => sp.Price.HasValue).ToList();
            if (!validPrices.Any()) continue;

            <div class="card mb-4 border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-header d-flex justify-content-between align-items-center py-3 px-4"
                     style="background: linear-gradient(135deg, #090e1a 0%, #1e293b 100%); color: white; border-top-left-radius:16px; border-top-right-radius:16px;">
                    <div class="d-flex align-items-center gap-2">
                        <span style="font-size:1.4rem">💰</span>
                        <h5 class="mb-0 fw-bold font-heading text-white">@product.ProductName</h5>
                    </div>
                    <div>
                        <span class="badge badge-our-price fs-6 px-3 py-2">
                            Bizim Fiyat: @FormatPrice(product.OurPrice) ₺
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead style="background:#f8fafc;">
                                <tr>
                                    <th class="ps-4" style="width: 35%">🏛️ Banka</th>
                                    <th style="width: 25%" class="text-end">Banka Fiyatı</th>
                                    <th style="width: 20%" class="text-end">Fark (TL)</th>
                                    <th style="width: 20%" class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sp in product.SellerPrices.Where(sp => sp.Price.HasValue))
                                {
                                    var isOurCheaper = sp.DiffFromOurs.HasValue && sp.DiffFromOurs.Value > 0;
                                    var isOurExpensive = sp.DiffFromOurs.HasValue && sp.DiffFromOurs.Value < 0;
                                    var rowBg = isOurCheaper ? "background-color: rgba(16, 185, 129, 0.05);"
                                              : isOurExpensive ? "background-color: rgba(244, 63, 94, 0.05);"
                                              : "";

                                    <tr style="@rowBg">
                                        <td class="ps-4 fw-semibold text-dark">
                                            <span class="me-2 opacity-75">🏛️</span> @sp.SellerName
                                        </td>
                                        <td class="text-end fw-bold price-tag" style="font-size: 1.05rem;">
                                            @FormatPrice(sp.Price.Value) ₺
                                        </td>
                                        <td class="text-end fw-bold @(isOurCheaper ? "text-success" : isOurExpensive ? "text-danger" : "text-muted")">
                                            @if (sp.DiffFromOurs.HasValue)
                                            {
                                                <span class="num-tabular">
                                                    @(sp.DiffFromOurs.Value > 0 ? "+" : "")@FormatPrice(sp.DiffFromOurs.Value) ₺
                                                </span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (isOurCheaper)
                                            {
                                                <span class="diff-badge-green">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Biz Ucuzuz
                                                </span>
                                            }
                                            else if (isOurExpensive)
                                            {
                                                <span class="diff-badge-red">
                                                    <i class="bi bi-arrow-up-right-circle-fill me-1"></i>Rakip Ucuz
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary px-3 py-1.5">➖ Eşit</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .spin {
        animation: spin 1s linear infinite;
        display: inline-block;
    }
    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>

@code {
    private List<ProductSellerBreakdownDto>? _breakdown;
    private bool _loading = true;
    private bool _refreshing = false;
    private bool _isSyncing = false;
    private DateTime? _lastUpdated;
    private DateTime? _lastLoadedScrapedAt;

    // Sadece gerçek banka isimleri - diğer satıcılar banka sayfasında gösterilmeyecek
    private static readonly HashSet<string> BankNames = new(StringComparer.OrdinalIgnoreCase)
    {
        "QNB", "QNB Finans", "QNB Finansbank",
        "Garanti", "Garanti BBVA", "Garanti Bankası",
        "Yapı Kredi", "Yapıkredi", "YapıKredi", "Yapı Kredi Bankası",
        "Ziraat", "Ziraat Bankası",
        "İş Bankası", "Türkiye İş Bankası",
        "Halkbank", "Halk Bankası",
        "Vakıfbank", "VakıfBank",
        "Akbank",
        "Denizbank", "DenizBank",
        "ING", "ING Bank",
        "TEB", "Türk Ekonomi Bankası",
        "HSBC",
        "Kuveyt Türk", "KuveytTürk"
    };

    private int _cheaperCount;
    private int _expensiveCount;
    private int _equalCount;

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadDataAsync();
        _loading = false;

        // Sayfa açıldığında son tarama zamanını sorgula
        try
        {
            var status = await Api.GetAsync<ScraperStatusDto>("api/v1/scraper/status?platform=bank");
            if (status?.LastScrapedAt.HasValue == true)
            {
                _lastLoadedScrapedAt = status.LastScrapedAt.Value;
            }
        }
        catch { }
    }

    private async Task LoadDataAsync()
    {
        var raw = await Api.GetAsync<List<ProductSellerBreakdownDto>>($"api/v1/products/seller-breakdown?sellerType=Bank&_t={DateTime.UtcNow.Ticks}");

        if (raw != null)
        {
            // Sadece banka isimlerini filtrele
            foreach (var product in raw)
            {
                product.SellerPrices = product.SellerPrices
                    .Where(sp => BankNames.Any(bn => sp.SellerName.Contains(bn, StringComparison.OrdinalIgnoreCase)))
                    .ToList();
            }

            _breakdown = raw;
            _lastUpdated = DateTime.Now;

            // İstatistik hesapla
            var allPrices = raw.SelectMany(p => p.SellerPrices).Where(sp => sp.DiffFromOurs.HasValue);
            _cheaperCount = allPrices.Count(sp => sp.DiffFromOurs > 0);
            _expensiveCount = allPrices.Count(sp => sp.DiffFromOurs < 0);
            _equalCount = allPrices.Count(sp => sp.DiffFromOurs == 0);
        }
    }

    private async Task TriggerLiveSyncAsync()
    {
        if (!Api.IsAuthenticated || _isSyncing) return;

        _isSyncing = true;
        StateHasChanged();

        try
        {
            // 1. Python banka scraper'ını anlık olarak tetikle ve tamamlanmasını bekle
            await Api.PostEmptyAsync<object>("api/v1/scraper/trigger?platform=bank&force=true&wait=true");
        }
        catch
        {
            // Scraper hatası oluşsa bile verileri yenilemeyi dene
        }

        // 2. Güncellenen kurları çek
        await LoadDataAsync();

        // 3. Son tarama zaman damgasını güncelle
        try
        {
            var status = await Api.GetAsync<ScraperStatusDto>("api/v1/scraper/status?platform=bank");
            if (status?.LastScrapedAt.HasValue == true)
            {
                _lastLoadedScrapedAt = status.LastScrapedAt.Value;
            }
        }
        catch { }

        _isSyncing = false;
        StateHasChanged();
    }

    private async Task RefreshDataAsync()
    {
        if (!Api.IsAuthenticated) return;

        _refreshing = true;
        StateHasChanged();

        await LoadDataAsync();

        _refreshing = false;
        StateHasChanged();
    }

    public void Dispose()
    {
    }

    /// <summary>
    /// Fiyatı Türkçe formatında gösterir: bin ayırıcı ile (2.599,50 TL)
    /// </summary>
    private string FormatPrice(decimal price)
    {
        var turkishCulture = new System.Globalization.CultureInfo("tr-TR");
        return price.ToString("N2", turkishCulture);
    }
}
