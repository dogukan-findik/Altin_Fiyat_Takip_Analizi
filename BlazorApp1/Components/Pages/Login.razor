@page "/login"
@using Altin_Fiyat_Takip_Analizi.Web.Models
@using Altin_Fiyat_Takip_Analizi.Web.Services
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Giriş Yap — Ahlatcı Altın Takip Portalı</PageTitle>

<div class="login-screen-bg">
    <div class="login-modal-wrapper row g-0">
        <!-- Sol Panel: Kurumsal Tanıtım & Özellikler -->
        <div class="col-lg-6 login-hero-side d-flex flex-column justify-content-between">
            <div>
                <!-- Brand Badge -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span style="display:inline-flex; align-items:center; justify-content:center; width:52px; height:52px; border-radius:14px; background:linear-gradient(135deg, rgba(226,176,62,0.22), rgba(226,176,62,0.06)); border:1px solid rgba(226,176,62,0.4); color:var(--gold-400); font-size:1.75rem; box-shadow:0 0 25px rgba(226,176,62,0.25);">
                        💰
                    </span>
                    <div>
                        <h3 class="font-heading fw-bold text-white mb-0" style="letter-spacing:-0.02em;">Ahlatcı Finans</h3>
                        <span class="text-gold-gradient fw-bold" style="font-size:0.85rem; letter-spacing:0.04em;">ALTIN TAKİP & ANALİZ SİSTEMİ</span>
                    </div>
                </div>

                <h2 class="text-white font-heading fw-bold mb-3" style="font-size:1.75rem; line-height:1.25;">
                    Piyasa Kurlarını ve Arbitrajı <span class="text-gold-gradient">Canlı Yönetin</span>
                </h2>
                

                <!-- Value Proposition Highlights -->
                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex align-items-center gap-3 p-2.5 rounded-3" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px; background:rgba(59,130,246,0.15); color:var(--blue-400); font-size:1.1rem; flex-shrink:0;">
                            <i class="bi bi-bank"></i>
                        </div>
                        <div>
                            <div class="text-white fw-semibold" style="font-size:0.85rem;">Banka & Pazaryeri Entegrasyonu</div>
                            <small class="text-muted" style="font-size:0.75rem;">QNB, Garanti, YK, N11, PTTAVM, Pazarama</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 p-2.5 rounded-3" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px; background:rgba(16,185,129,0.15); color:var(--emerald-400); font-size:1.1rem; flex-shrink:0;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div>
                            <div class="text-white fw-semibold" style="font-size:0.85rem;">Anlık Fark ve Arbitraj Tespiti</div>
                            <small class="text-muted" style="font-size:0.75rem;">Mağaza kurları ile rakipler arasındaki fiyat makası</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 p-2.5 rounded-3" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px; background:rgba(226,176,62,0.15); color:var(--gold-400); font-size:1.1rem; flex-shrink:0;">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <div>
                            <div class="text-white fw-semibold" style="font-size:0.85rem;">Python Scraper Motoru</div>
                            <small class="text-muted" style="font-size:0.75rem;">Otomatik arka plan senkronizasyonu ve tek tıkla tarama</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Badge -->
            <div class="pt-3 d-flex align-items-center justify-content-between" style="border-top:1px solid rgba(255,255,255,0.06);">
                <div class="pulse-indicator-container pulse-live-green" style="background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.25);">
                    <span class="pulse-dot pulse-dot-green"></span>
                    <span class="text-white" style="font-size:0.75rem;">Canlı Veri Ağı Aktif</span>
                </div>
                <small class="text-muted" style="font-size:0.75rem;">v2.4 Finans Sürümü</small>
            </div>
        </div>

        <!-- Sağ Panel: Giriş Formu -->
        <div class="col-lg-6 login-form-side d-flex flex-column justify-content-center">
            <div class="mb-4">
                <h3 class="font-heading fw-bold text-white mb-1" style="font-size:1.75rem;">Hoş Geldiniz</h3>
                <p class="text-slate-400 mb-0" style="font-size:0.88rem;">Yetkili kullanıcı bilgilerinizle sisteme giriş yapın</p>
            </div>

            <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
                <div class="login-input-group">
                    <label><i class="bi bi-person-fill me-1 text-gold"></i> Kullanıcı Adı</label>
                    <div class="login-input-wrapper">
                        <i class="bi bi-person-badge input-icon"></i>
                        <InputText @bind-Value="_loginModel.Username" class="form-control" placeholder="Kullanıcı adınızı girin" autocomplete="username" />
                    </div>
                </div>

                <div class="login-input-group">
                    <label><i class="bi bi-shield-lock-fill me-1 text-gold"></i> Şifre</label>
                    <div class="login-input-wrapper">
                        <i class="bi bi-key-fill input-icon"></i>
                        <InputText @bind-Value="_loginModel.Password" type="@(_showPassword ? "text" : "password")" class="form-control" placeholder="Şifrenizi girin" autocomplete="current-password" />
                        <button type="button" class="toggle-pwd-btn" @onclick="TogglePassword" title="@(_showPassword ? "Şifreyi Gizle" : "Şifreyi Göster")">
                            <i class="bi @(_showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert mb-3 d-flex align-items-center gap-2" style="background:rgba(239,68,68,0.15); color:#fca5a5; border:1px solid rgba(239,68,68,0.3); border-radius:12px; font-size:0.85rem; padding:0.75rem 1rem;">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0" style="font-size:1.1rem; color:#f87171;"></i>
                        <span>@_errorMessage</span>
                    </div>
                }

                <div class="pt-2 mb-4">
                    <button type="submit" class="btn btn-gold w-100 py-3 rounded-3 font-heading fw-bold d-flex align-items-center justify-content-center gap-2" 
                            disabled="@_isLoading" style="font-size:1rem; letter-spacing:0.02em;">
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Doğrulanıyor...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right fs-5"></i>
                            <span>Sisteme Giriş Yap</span>
                        }
                    </button>
                </div>

                <div class="text-center pt-3" style="border-top:1px solid rgba(255,255,255,0.06);">
                    <small class="text-muted d-inline-flex align-items-center gap-1" style="font-size:0.75rem;">
                        <i class="bi bi-lock-fill text-gold"></i> 256-bit SSL Korumalı Ahlatcı Kuyumculuk Portalı
                    </small>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginDto _loginModel = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _showPassword = false;

    private void TogglePassword() => _showPassword = !_showPassword;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_loginModel.Username) || string.IsNullOrWhiteSpace(_loginModel.Password))
        {
            _errorMessage = "Lütfen kullanıcı adı ve şifrenizi eksiksiz girin.";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        var result = await Api.PostAsync<LoginDto, AuthResponseDto>("api/v1/auth/login", _loginModel);

        if (result is null)
        {
            _errorMessage = "Kullanıcı adı veya şifre hatalı.";
            _isLoading = false;
            return;
        }

        Api.SetToken(result.Token);
        Api.SetCurrentUser(result.Username, result.Role);
        Nav.NavigateTo("/", forceLoad: false);
    }
}