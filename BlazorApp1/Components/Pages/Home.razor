@page "/"
@using Altin_Fiyat_Takip_Analizi.Web.Services
@inject ApiService Api
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(Api.IsAuthenticated ? "Anasayfa - Altın Fiyat Takip" : "Giriş Yap — Ahlatcı Altın Takip Portalı")</PageTitle>

@if (!Api.IsAuthenticated)
{
    <Login />
}
else
{
    <div class="page-header d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="font-heading mb-1" style="font-size:1.85rem;">Hoş geldin, <span class="text-gold-gradient fw-bold">@Api.CurrentUsername</span></h2>
            <p class="text-muted mb-0">Altın fiyat takip ve arbitraj analiz sistemine genel bakış</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="pulse-indicator-container pulse-live-green">
                <span class="pulse-dot pulse-dot-green"></span>
                <span>Piyasa Çevrimiçi</span>
            </span>
            <span class="badge rounded-pill px-3 py-2 text-uppercase" style="background:rgba(226,176,62,.15); color:#e2b03e; font-weight:700; font-size:.82rem; border:1px solid rgba(226,176,62,.3);">
                <i class="bi bi-shield-check me-1"></i>@Api.CurrentRole
            </span>
        </div>
    </div>

    <!-- Quick Navigation Cards Grid (5 Platforms: Banka, N11, PTTAVM, Pazarama, Raporlar) -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
        <!-- 1. Banka Kurları -->
        <div class="col">
            <div class="card border-0 card-hoverable h-100" style="cursor:pointer; border-radius:18px;" @onclick="GoToBank">
                <div class="card-body p-3.5 stat-blue d-flex flex-column justify-content-between h-100" style="border-radius:18px;">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(255,255,255,.2); width:42px; height:42px;">
                                <i class="bi bi-bank" style="font-size:1.35rem; color:#fff;"></i>
                            </div>
                            <span class="badge rounded-pill" style="background:rgba(0,0,0,0.22); color:#ffffff; font-size:0.72rem; font-weight:700; border:1px solid rgba(255,255,255,0.28); padding:3px 9px;">Canlı</span>
                        </div>
                        <h4 class="fw-bold font-heading text-white mb-1" style="font-size:1.25rem;">Banka Kurları</h4>
                        <p class="text-white text-opacity-80 mb-3" style="font-size:0.82rem; line-height:1.4;">QNB, Garanti ve Yapı Kredi altın kurları karşılaştırması.</p>
                    </div>
                    <span class="text-white fw-bold d-inline-flex align-items-center gap-1 mt-auto" style="font-size:0.82rem;">
                        İncele <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. N11 Pazaryeri -->
        <div class="col">
            <div class="card border-0 card-hoverable h-100" style="cursor:pointer; border-radius:18px;" @onclick="GoToMarketplace">
                <div class="card-body p-3.5 stat-purple d-flex flex-column justify-content-between h-100" style="border-radius:18px;">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(255,255,255,.2); width:42px; height:42px;">
                                <i class="bi bi-shop" style="font-size:1.35rem; color:#fff;"></i>
                            </div>
                            <span class="badge rounded-pill" style="background:rgba(0,0,0,0.22); color:#ffffff; font-size:0.72rem; font-weight:700; border:1px solid rgba(255,255,255,0.28); padding:3px 9px;">Pazaryeri</span>
                        </div>
                        <h4 class="fw-bold font-heading text-white mb-1" style="font-size:1.25rem;">N11 Pazaryeri</h4>
                        <p class="text-white text-opacity-80 mb-3" style="font-size:0.82rem; line-height:1.4;">N11 satıcılarının altın ve ziynet fiyat karşılaştırması.</p>
                    </div>
                    <span class="text-white fw-bold d-inline-flex align-items-center gap-1 mt-auto" style="font-size:0.82rem;">
                        İncele <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </div>
        </div>

        <!-- 3. PTTAVM Pazaryeri -->
        <div class="col">
            <div class="card border-0 card-hoverable h-100" style="cursor:pointer; border-radius:18px;" @onclick="@(() => Nav.NavigateTo("/pttavm-karsilastirma"))">
                <div class="card-body p-3.5 stat-amber d-flex flex-column justify-content-between h-100" style="border-radius:18px;">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(255,255,255,.2); width:42px; height:42px;">
                                <i class="bi bi-bag-check-fill" style="font-size:1.35rem; color:#fff;"></i>
                            </div>
                            <span class="badge rounded-pill" style="background:rgba(0,0,0,0.22); color:#ffffff; font-size:0.72rem; font-weight:700; border:1px solid rgba(255,255,255,0.28); padding:3px 9px;">Pazaryeri</span>
                        </div>
                        <h4 class="fw-bold font-heading text-white mb-1" style="font-size:1.25rem;">PTTAVM</h4>
                        <p class="text-white text-opacity-80 mb-3" style="font-size:0.82rem; line-height:1.4;">PTTAVM altın kampanyaları ve satıcı ürün fiyatları.</p>
                    </div>
                    <span class="text-white fw-bold d-inline-flex align-items-center gap-1 mt-auto" style="font-size:0.82rem;">
                        İncele <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </div>
        </div>

        <!-- 4. Pazarama Pazaryeri (YENİ EKLENDİ) -->
        <div class="col">
            <div class="card border-0 card-hoverable h-100" style="cursor:pointer; border-radius:18px;" @onclick="@(() => Nav.NavigateTo("/pazarama-karsilastirma"))">
                <div class="card-body p-3.5 stat-indigo d-flex flex-column justify-content-between h-100" style="border-radius:18px;">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(255,255,255,.2); width:42px; height:42px;">
                                <i class="bi bi-cart4" style="font-size:1.35rem; color:#fff;"></i>
                            </div>
                            <span class="badge rounded-pill" style="background:rgba(0,0,0,0.22); color:#ffffff; font-size:0.72rem; font-weight:700; border:1px solid rgba(255,255,255,0.28); padding:3px 9px;">Pazaryeri</span>
                        </div>
                        <h4 class="fw-bold font-heading text-white mb-1" style="font-size:1.25rem;">Pazarama</h4>
                        <p class="text-white text-opacity-80 mb-3" style="font-size:0.82rem; line-height:1.4;">Pazarama satıcılarının ürünleri ve anlık kur analizi.</p>
                    </div>
                    <span class="text-white fw-bold d-inline-flex align-items-center gap-1 mt-auto" style="font-size:0.82rem;">
                        İncele <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </div>
        </div>

        <!-- 5. Günlük Raporlar -->
        <div class="col">
            <div class="card border-0 card-hoverable h-100" style="cursor:pointer; border-radius:18px;" @onclick="GoToReports">
                <div class="card-body p-3.5 stat-green d-flex flex-column justify-content-between h-100" style="border-radius:18px;">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="background:rgba(255,255,255,.2); width:42px; height:42px;">
                                <i class="bi bi-file-earmark-bar-graph" style="font-size:1.35rem; color:#fff;"></i>
                            </div>
                            <span class="badge rounded-pill" style="background:rgba(0,0,0,0.22); color:#ffffff; font-size:0.72rem; font-weight:700; border:1px solid rgba(255,255,255,0.28); padding:3px 9px;">Rapor</span>
                        </div>
                        <h4 class="fw-bold font-heading text-white mb-1" style="font-size:1.25rem;">Günlük Rapor</h4>
                        <p class="text-white text-opacity-80 mb-3" style="font-size:0.82rem; line-height:1.4;">Detaylı günlük özet ve en ucuz/pahalı analizleri.</p>
                    </div>
                    <span class="text-white fw-bold d-inline-flex align-items-center gap-1 mt-auto" style="font-size:0.82rem;">
                        İncele <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- System Features Information Box -->
    <div class="card border-0 mb-4 shadow-sm" style="border-radius:18px;">
        <div class="card-header d-flex align-items-center gap-2 py-3 px-4" style="background:rgba(255,255,255,0.85); border-bottom:1px solid var(--border);">
            <i class="bi bi-cpu text-gold" style="font-size:1.25rem;"></i>
            <h5 class="fw-bold font-heading mb-0 text-dark">Sistem Özellikleri ve Otomasyon</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3.5 rounded-3 h-100" style="background:#f8fafc; border:1px solid var(--border);">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="p-2 rounded-circle bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-arrow-repeat"></i>
                            </span>
                            <h6 class="fw-bold font-heading mb-0 text-dark">Arka Plan Taraması</h6>
                        </div>
                        <p class="text-muted mb-0" style="font-size:.85rem; line-height:1.5;">
                            Pazaryeri ve banka fiyatları arka planda otomatik taranarak fiyat geçmişi canlı tutulur.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3.5 rounded-3 h-100" style="background:#f8fafc; border:1px solid var(--border);">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="p-2 rounded-circle bg-success bg-opacity-10 text-success">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <h6 class="fw-bold font-heading mb-0 text-dark">Fark Analizi</h6>
                        </div>
                        <p class="text-muted mb-0" style="font-size:.85rem; line-height:1.5;">
                            Ahlatcı mağaza fiyatı baz alınarak rakiplerle anlık fiyat farkı ve arbitraj hesabı yapılır.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3.5 rounded-3 h-100" style="background:#f8fafc; border:1px solid var(--border);">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="p-2 rounded-circle bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-lightning-charge"></i>
                            </span>
                            <h6 class="fw-bold font-heading mb-0 text-dark">Canlı Senkronizasyon</h6>
                        </div>
                        <p class="text-muted mb-0" style="font-size:.85rem; line-height:1.5;">
                            Kullanıcı tek tıkla Python tarayıcısını anında tetikleyebilir ve kurları güncelleyebilir.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center py-2">
        <small class="text-muted"><i class="bi bi-clock me-1"></i>Son Sistem Güncellemesi: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</small>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Api.AuthStateChanged += OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Api.AuthStateChanged -= OnAuthChanged;
    }

    private void GoToBank() => Nav.NavigateTo("/banka-karsilastirma");
    private void GoToMarketplace() => Nav.NavigateTo("/pazaryeri-karsilastirma");
    private void GoToReports() => Nav.NavigateTo("/raporlar");
}
