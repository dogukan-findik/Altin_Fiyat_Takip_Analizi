@page "/pazarama-karsilastirma"
@using Altin_Fiyat_Takip_Analizi.Web.Models
@using Altin_Fiyat_Takip_Analizi.Web.Services
@implements IDisposable
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Pazarama Pazaryeri Karşılaştırma</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <span style="font-size:2rem" class="me-3">🛍️</span>
            <div>
                <h2 class="mb-0 fw-bold">Pazarama Pazaryeri Karşılaştırma</h2>
                <p class="text-muted mb-0">Pazarama'daki altın satıcılarının ürünleri, bizim mağaza fiyatlarımızla karşılaştırılıyor.</p>
            </div>
        </div>
            <div class="d-flex flex-column align-items-end gap-1">
                @if (_lastUpdated.HasValue)
                {
                    <small class="text-muted">
                        <i class="bi bi-clock me-1"></i>Son Veri: @_lastUpdated.Value.ToString("HH:mm:ss")
                    </small>
                }
                <div class="d-flex align-items-center gap-2 mt-1">
                    @if (_isPlatformScraping)
                    {
                        <span class="badge bg-warning text-dark border border-warning px-2 py-1" style="font-size: 0.78rem;">
                            <span class="spinner-border spinner-border-sm me-1 text-dark" role="status"></span>
                            ⚡ Canlı Taranıyor...
                        </span>
                    }
                    else if (_lastLoadedScrapedAt.HasValue)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="font-size: 0.78rem;">
                            <i class="bi bi-check2-circle me-1"></i>Son Tarama: @_lastLoadedScrapedAt.Value.ToLocalTime().ToString("HH:mm:ss")
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="font-size: 0.78rem;">
                            <span class="spinner-grow spinner-grow-sm me-1" style="width: 8px; height: 8px;" role="status"></span>
                            Canlı Takip Aktif
                        </span>
                    }
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="RefreshDataAsync" disabled="@_refreshing" title="Fiyatları Yenile">
                        <i class="bi bi-arrow-clockwise @(_refreshing ? "spin" : "")"></i>
                    </button>
                    @if (_refreshing)
                    {
                        <span class="badge bg-secondary text-white">Yenileniyor...</span>
                    }
                </div>
            </div>
        </div>

    @if (!Api.IsAuthenticated)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <span class="me-2">🔒</span>
            <span>Bu sayfayı görüntülemek için <a href="/login" class="alert-link">giriş yapmalısınız</a>.</span>
        </div>
    }
    else if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem; color: #6c5ce7 !important;">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="text-muted mt-3">Pazarama verileri yükleniyor...</p>
        </div>
    }
    else if (_sellers is null || _sellers.Count == 0)
    {
        <div class="alert alert-info d-flex align-items-center">
            <span class="me-2">ℹ️</span>
            <span>Henüz Pazarama karşılaştırma verisi bulunmuyor veya tarama işlemi devam ediyor.</span>
        </div>
    }
    else
    {
        @* Genel Özet Kartları - Tıklanabilir Filtreleme *@
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card stat-blue filter-card @(_activeFilter == "all" ? "filter-active-all" : "")"
                     @onclick="@(() => ToggleFilter("all"))">
                    <i class="bi bi-people stat-icon"></i>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="stat-label">Toplam Satıcı</div>
                        @if (_activeFilter == "all")
                        {
                            <span class="badge bg-white text-dark rounded-pill px-2 py-0.5" style="font-size:0.7rem; font-weight:700;">Seçili</span>
                        }
                    </div>
                    <div class="stat-value">@_sellers.Count</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-purple filter-card @(_activeFilter == "all" ? "filter-active-all" : "")"
                     @onclick="@(() => ToggleFilter("all"))">
                    <i class="bi bi-box-seam stat-icon"></i>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="stat-label">Toplam Ürün</div>
                        @if (_activeFilter == "all")
                        {
                            <span class="badge bg-white text-dark rounded-pill px-2 py-0.5" style="font-size:0.7rem; font-weight:700;">Seçili</span>
                        }
                    </div>
                    <div class="stat-value">@_totalProducts</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-green filter-card @(_activeFilter == "cheaper" ? "filter-active-cheaper" : "")"
                     @onclick="@(() => ToggleFilter("cheaper"))">
                    <i class="bi bi-shield-check stat-icon"></i>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="stat-label">Biz Ucuzuz</div>
                        @if (_activeFilter == "cheaper")
                        {
                            <span class="badge bg-white text-success rounded-pill px-2 py-0.5" style="font-size:0.7rem; font-weight:700;">Seçili</span>
                        }
                    </div>
                    <div class="stat-value">@_cheaperCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-red filter-card @(_activeFilter == "expensive" ? "filter-active-expensive" : "")"
                     @onclick="@(() => ToggleFilter("expensive"))">
                    <i class="bi bi-exclamation-triangle stat-icon"></i>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="stat-label">Biz Pahalıyız</div>
                        @if (_activeFilter == "expensive")
                        {
                            <span class="badge bg-white text-danger rounded-pill px-2 py-0.5" style="font-size:0.7rem; font-weight:700;">Seçili</span>
                        }
                    </div>
                    <div class="stat-value">@_expensiveCount</div>
                </div>
            </div>
        </div>

        @* Aktif Filtre Bilgilendirme ve Hızlı Temizleme *@
        <div class="mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="d-flex align-items-center gap-1">
                    <span class="d-inline-block rounded" style="width:14px;height:14px;background-color: rgba(40, 167, 69, 0.15);border: 1px solid #28a745;"></span>
                    <small class="text-muted">Biz daha ucuzuz</small>
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span class="d-inline-block rounded" style="width:14px;height:14px;background-color: rgba(220, 53, 69, 0.15);border: 1px solid #dc3545;"></span>
                    <small class="text-muted">Biz daha pahalıyız</small>
                </span>
            </div>

            @if (_activeFilter != "all")
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(_activeFilter == "expensive" ? "bg-danger" : "bg-success") px-3 py-2">
                        Filtre: @(_activeFilter == "expensive" ? "⚠️ Yalnızca Bizim Pahalı Olduğumuz Ürünler" : "✅ Yalnızca Bizim Ucuz Olduğumuz Ürünler")
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SetFilter("all"))">
                        <i class="bi bi-x-circle me-1"></i>Tümünü Göster
                    </button>
                </div>
            }
        </div>

        @* ÖZEL BÖLÜM: BİZ PAHALIYIZ SEÇİLDİĞİNDE EN YÜKSEK FİYAT FARKLARI TOPLU ÖZET LİSTESİ *@
        @if (_activeFilter == "expensive")
        {
            var expensiveList = _sellers.SelectMany(s => s.Products.Where(p => p.PriceDiff > 0).Select(p => new { Seller = s.SellerName, Product = p }))
                                        .OrderByDescending(x => x.Product.PriceDiff)
                                        .ToList();

            <div class="card mb-4 border-danger shadow-sm" style="border-width: 2px;">
                <div class="card-header bg-danger text-white py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <span style="font-size:1.5rem" class="me-2">⚠️</span>
                        <div>
                            <h5 class="mb-0 fw-bold">Pahalı Olduğumuz Ürünler Listesi</h5>
                            <small class="opacity-75">Bizim fiyatımızın Pazarama satıcılarından daha yüksek olduğu toplam @expensiveList.Count ürün listeleniyor.</small>
                        </div>
                    </div>
                    <span class="badge bg-light text-danger fw-bold fs-6 px-3 py-2">@expensiveList.Count Ürün</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle" style="font-size: 0.92rem;">
                            <thead style="background-color: #fff5f5;">
                                <tr>
                                    <th class="ps-4" style="width: 22%">🏢 Satıcı / Mağaza</th>
                                    <th style="width: 26%">📦 Pazarama Ürün Adı</th>
                                    <th style="width: 14%" class="text-end">Satıcı Fiyatı</th>
                                    <th style="width: 14%" class="text-end">Bizim Fiyat</th>
                                    <th style="width: 12%" class="text-end">Pahalı Olduğumuz Fark</th>
                                    <th style="width: 12%" class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in expensiveList)
                                {
                                    <tr style="background-color: rgba(220, 53, 69, 0.04);">
                                        <td class="ps-4 fw-bold text-dark">
                                            <span class="badge me-1" style="background-color: #6c5ce7; color: white;">Pazarama</span>
                                            @item.Seller
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Product.ExternalUrl))
                                            {
                                                <a href="@item.Product.ExternalUrl" target="_blank" class="text-decoration-none text-dark fw-semibold">
                                                    @item.Product.ExternalProductName
                                                    <small class="ms-1" style="color: #6c5ce7;">🔗</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold">@item.Product.ExternalProductName</span>
                                            }
                                            <div class="text-muted" style="font-size:0.75rem;">
                                                Eşleşen: <span class="badge bg-light text-dark border">@item.Product.MatchedProductName</span>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold" style="font-size: 1.02rem;">
                                            @FormatPrice(item.Product.SellerPrice) ₺
                                        </td>
                                        <td class="text-end fw-bold text-danger" style="font-size: 1.02rem;">
                                            @FormatPrice(item.Product.OurPrice) ₺
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            +@FormatPrice(item.Product.PriceDiff) ₺
                                            <br />
                                            <small class="text-danger fw-normal">
                                                (+@item.Product.PriceDiffPercent.ToString("N1")%)
                                            </small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill px-3 py-2" style="background-color: #f8d7da; color: #721c24; font-size: 0.78rem;">
                                                ⚠️ Pahalıyız
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @* Satıcı Bazlı Detay Listesi *@
        var displayedSellers = GetFilteredSellers();

        @if (!displayedSellers.Any())
        {
            <div class="alert alert-info text-center py-4">
                <span style="font-size: 1.5rem;" class="d-block mb-2">🔍</span>
                <span>Seçilen filtre kriterine uygun satıcı veya ürün bulunamadı.</span>
            </div>
        }

        @foreach (var seller in displayedSellers)
        {
            var sellerCheaper = seller.Products.Count(p => p.PriceDiff < 0);
            var sellerExpensive = seller.Products.Count(p => p.PriceDiff > 0);
            var sellerEqual = seller.Products.Count(p => p.PriceDiff == 0);
            var sellerScore = seller.Products.Count > 0
                ? (sellerCheaper * 100.0 / seller.Products.Count)
                : 0;

            var filteredProducts = GetFilteredProducts(seller.Products);

            <div class="card mb-4 border-0 shadow-sm overflow-hidden" style="border-radius:16px;">
                <div class="card-header seller-card-header border-0 py-3 px-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center">
                            <span style="font-size:1.4rem; display:inline-flex; align-items:center; justify-content:center; width:38px; height:38px; border-radius:10px; background:rgba(226,176,62,0.18); border:1px solid rgba(226,176,62,0.35); margin-right:0.75rem;">🛍️</span>
                            <div>
                                <h5 class="mb-0 fw-bold font-heading text-white" style="color:#ffffff !important; font-size:1.2rem; letter-spacing:-0.01em;">
                                    @seller.SellerName
                                </h5>
                                <small style="color:#cbd5e1 !important; font-size:0.82rem;">
                                    @if (_activeFilter == "expensive")
                                    {
                                        <span style="color:#f87171 !important; font-weight:600;">@filteredProducts.Count pahalı ürün gösteriliyor</span>
                                    }
                                    else if (_activeFilter == "cheaper")
                                    {
                                        <span style="color:#4ade80 !important; font-weight:600;">@filteredProducts.Count ucuz ürün gösteriliyor</span>
                                    }
                                    else
                                    {
                                        <span style="color:#cbd5e1 !important;">@seller.Products.Count ürün takip ediliyor (Pazarama)</span>
                                    }
                                </small>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge bg-success px-3 py-2 font-heading fw-bold" style="box-shadow:0 2px 8px rgba(16,185,129,0.3);">✅ @sellerCheaper ucuz</span>
                            <span class="badge bg-danger px-3 py-2 font-heading fw-bold" style="box-shadow:0 2px 8px rgba(239,68,68,0.3);">⚠️ @sellerExpensive pahalı</span>
                            @if (sellerEqual > 0)
                            {
                                <span class="badge bg-secondary px-3 py-2">➖ @sellerEqual eşit</span>
                            }
                        </div>
                    </div>
                    @* İlerleme çubuğu *@
                    <div class="progress mt-2" style="height: 4px; background-color: rgba(255,255,255,0.2);">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @sellerScore.ToString("F0")%"></div>
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @((100 - sellerScore).ToString("F0"))%"></div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle" style="font-size: 0.92rem;">
                            <thead style="background-color: #f8f9fa;">
                                <tr>
                                    <th class="ps-4" style="width: 28%">
                                        <span class="text-muted">📦 Pazarama Ürün Adı</span>
                                    </th>
                                    <th style="width: 14%" class="text-end">
                                        <span class="text-muted">Satıcı Fiyatı</span>
                                    </th>
                                    <th style="width: 22%" class="text-center">
                                        <span class="text-muted">🔗 Eşleşen Ürünümüz</span>
                                    </th>
                                    <th style="width: 14%" class="text-end">
                                        <span class="text-muted">Bizim Fiyat</span>
                                    </th>
                                    <th style="width: 10%" class="text-end">
                                        <span class="text-muted">Fark</span>
                                    </th>
                                    <th style="width: 10%" class="text-center">
                                        <span class="text-muted">Durum</span>
                                    </th>
                                    <th style="width: 10%" class="text-center">
                                        <span class="text-muted">🕒 Son Tarama</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in filteredProducts)
                                {
                                    var isOurCheaper = product.PriceDiff < 0;
                                    var isOurExpensive = product.PriceDiff > 0;
                                    var rowBg = isOurCheaper ? "background-color: rgba(40, 167, 69, 0.04);"
                                              : isOurExpensive ? "background-color: rgba(220, 53, 69, 0.04);"
                                              : "";

                                    <tr style="@rowBg">
                                        <td class="ps-4">
                                            @if (!string.IsNullOrEmpty(product.ExternalUrl))
                                            {
                                                <a href="@product.ExternalUrl" target="_blank" class="text-decoration-none text-dark fw-semibold">
                                                    @product.ExternalProductName
                                                    <small class="ms-1" style="color: #6c5ce7;">🔗</small>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold">@product.ExternalProductName</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold" style="font-size: 1.02rem;">
                                            @FormatPrice(product.SellerPrice) ₺
                                        </td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill px-3 py-1" style="background-color: #f3e5f5; color: #6a1b9a; font-size: 0.82rem;">
                                                @product.MatchedProductName
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold" style="font-size: 1.02rem;">
                                            @FormatPrice(product.OurPrice) ₺
                                        </td>
                                        <td class="text-end fw-bold @(isOurCheaper ? "text-success" : isOurExpensive ? "text-danger" : "")">
                                            @(product.PriceDiff > 0 ? "+" : "")@FormatPrice(product.PriceDiff) ₺
                                            <br />
                                            <small class="fw-normal @(isOurCheaper ? "text-success" : isOurExpensive ? "text-danger" : "text-muted")">
                                                (@(product.PriceDiffPercent > 0 ? "+" : "")@product.PriceDiffPercent.ToString("N1")%)
                                            </small>
                                        </td>
                                        <td class="text-center">
                                            @if (isOurCheaper)
                                            {
                                                <span class="badge rounded-pill px-3 py-2" style="background-color: #d4edda; color: #155724; font-size: 0.78rem;">
                                                    ✅ Ucuzuz
                                                </span>
                                            }
                                            else if (isOurExpensive)
                                            {
                                                <span class="badge rounded-pill px-3 py-2" style="background-color: #f8d7da; color: #721c24; font-size: 0.78rem;">
                                                    ⚠️ Pahalıyız
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary px-3 py-2" style="font-size: 0.78rem;">➖ Eşit</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.78rem;" title="@product.CollectedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")">
                                                <i class="bi bi-clock me-1 text-info"></i>@product.CollectedAt.ToLocalTime().ToString("HH:mm:ss")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .filter-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(0,0,0,0.15) !important;
    }
    .filter-active-expensive {
        transform: translateY(-4px);
        box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.4), 0 10px 22px rgba(220, 53, 69, 0.3) !important;
    }
    .filter-active-cheaper {
        transform: translateY(-4px);
        box-shadow: 0 0 0 4px rgba(40, 167, 69, 0.4), 0 10px 22px rgba(40, 167, 69, 0.3) !important;
    }
    .filter-active-all {
        transform: translateY(-4px);
        box-shadow: 0 0 0 4px rgba(108, 92, 231, 0.4), 0 10px 22px rgba(108, 92, 231, 0.3) !important;
    }
</style>

@code {
    private List<SellerProductBreakdownDto>? _sellers;
    private bool _loading = true;
    private bool _refreshing = false;
    private int _totalProducts;
    private int _cheaperCount;
    private int _expensiveCount;
    private DateTime? _lastUpdated;
    private DateTime? _lastLoadedScrapedAt;
    private bool _isPlatformScraping = false;
    private readonly CancellationTokenSource _cts = new();
    private string _activeFilter = "all"; // "all", "cheaper", "expensive"

    protected override async Task OnInitializedAsync()
    {
        if (!Api.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _loading = true;
        await LoadDataAsync();
        _loading = false;

        // Sayfa ilk yüklendiğinde mevcut tarama zaman damgasını al
        try
        {
            var initStatus = await Api.GetAsync<ScraperStatusDto>("api/v1/scraper/status?platform=pazarama");
            if (initStatus != null)
            {
                _lastLoadedScrapedAt = initStatus.LastScrapedAt;
                _isPlatformScraping = initStatus.IsScraping;
            }
        }
        catch { }

        // Blazor UI Dispatcher ile tam uyumlu periyodik kontrol döngüsü (3 saniyede bir)
        _ = StartAutoSyncLoopAsync();
    }

    private async Task StartAutoSyncLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        while (!_cts.IsCancellationRequested && await timer.WaitForNextTickAsync(_cts.Token))
        {
            try
            {
                await InvokeAsync(CheckAutoSyncAsync);
            }
            catch (ObjectDisposedException) { break; }
            catch { }
        }
    }

    private async Task CheckAutoSyncAsync()
    {
        if (!Api.IsAuthenticated || _refreshing) return;

        try
        {
            var status = await Api.GetAsync<ScraperStatusDto>("api/v1/scraper/status?platform=pazarama");
            if (status != null)
            {
                bool scrapingChanged = _isPlatformScraping != status.IsScraping;
                _isPlatformScraping = status.IsScraping;

                // Eğer tarama tamamlandıysa (yeni zaman damgası geldiyse)
                if (status.LastScrapedAt.HasValue && 
                    (_lastLoadedScrapedAt == null || status.LastScrapedAt.Value > _lastLoadedScrapedAt.Value))
                {
                    _lastLoadedScrapedAt = status.LastScrapedAt.Value;
                    await LoadDataAsync();
                    StateHasChanged();
                }
                else if (scrapingChanged)
                {
                    StateHasChanged();
                }
            }
        }
        catch
        {
            // Sessizce geç
        }
    }

    private void ToggleFilter(string filter)
    {
        if (_activeFilter == filter && filter != "all")
            _activeFilter = "all";
        else
            _activeFilter = filter;
    }

    private void SetFilter(string filter)
    {
        _activeFilter = filter;
    }

    private List<SellerProductBreakdownDto> GetFilteredSellers()
    {
        if (_sellers == null) return new List<SellerProductBreakdownDto>();

        if (_activeFilter == "expensive")
            return _sellers.Where(s => s.Products.Any(p => p.PriceDiff > 0)).ToList();

        if (_activeFilter == "cheaper")
            return _sellers.Where(s => s.Products.Any(p => p.PriceDiff < 0)).ToList();

        return _sellers;
    }

    private List<SellerProductComparisonDto> GetFilteredProducts(List<SellerProductComparisonDto> products)
    {
        if (_activeFilter == "expensive")
            return products.Where(p => p.PriceDiff > 0).ToList();

        if (_activeFilter == "cheaper")
            return products.Where(p => p.PriceDiff < 0).ToList();

        return products;
    }

    private async Task LoadDataAsync()
    {
        var data = await Api.GetAsync<List<SellerProductBreakdownDto>>($"api/v1/products/seller-product-breakdown?sellerType=MarketPlace&platform=pazarama&_t={DateTime.UtcNow.Ticks}");

        if (data != null)
        {
            _sellers = data;
            var allProducts = _sellers.SelectMany(s => s.Products).ToList();
            _totalProducts = allProducts.Count;
            _cheaperCount = allProducts.Count(p => p.PriceDiff < 0);
            _expensiveCount = allProducts.Count(p => p.PriceDiff > 0);
            _lastUpdated = DateTime.Now;
        }
    }

    private async Task RefreshDataAsync()
    {
        if (!Api.IsAuthenticated) return;

        _refreshing = true;
        StateHasChanged();

        await LoadDataAsync();

        _refreshing = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    /// <summary>
    /// Fiyatı Türkçe formatında gösterir: bin ayırıcı ile (2.599,50 TL)
    /// </summary>
    private string FormatPrice(decimal price)
    {
        var turkishCulture = new System.Globalization.CultureInfo("tr-TR");
        return price.ToString("N2", turkishCulture);
    }
}
